{
  "layer": "top",
  "position": "top",
  "height": 48,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 8,

  // ==========================================
  // MODULE LAYOUT
  // ==========================================

  "modules-left": ["custom/arch", "hyprland/workspaces", "clock"],

  "modules-center": ["cpu", "memory", "temperature"],

  "modules-right": [
    "group/media",
    "group/system-center",
    "custom/mic",
    "privacy",
    "gamemode",
    "tray",
    "custom/power",
  ],

  // ==========================================
  // ARCH LAUNCHER
  // ==========================================

  "custom/arch": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Arch Linux",
    "on-click": "rofi -show drun",
  },

  // ==========================================
  // WORKSPACES
  // ==========================================

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "default": "󰋙",
      "active": "󰮯",
      "urgent": "󰀦",
    },
    "persistent-workspaces": {
      "*": 5,
    },
  },

  // ==========================================
  // CLOCK
  // ==========================================

  "clock": {
    "format": "󰥔  {:%H:%M 󰃭 %a %d %b}",
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y}",
  },

  // ==========================================
  // SYSTEM MONITORING
  // ==========================================

  "cpu": {
    "interval": 2,
    "format": "󰻠  {usage}%",
    "tooltip": true,
  },

  "memory": {
    "interval": 5,
    "format": "󰍛  {percentage}%",
    "tooltip": true,
  },

  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
    "format": "󰔏 {temperatureC}°C",
    "format-critical": "󰸁 {temperatureC}°C",
    "critical-threshold": 85,
    "interval": 5,
    "tooltip": true,
  },

  // ==========================================
  // MEDIA DRAWER
  // ==========================================

  "group/media": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "media-child",
      "transition-left-to-right": false,
    },
    "modules": ["custom/media-toggle", "mpris", "custom/cava"],
  },

  // ==========================================
  // MEDIA TRIGGER
  // ==========================================

  "custom/media-toggle": {
    "format": "󰝚",
    "tooltip": true,
    "tooltip-format": "Media controls\nHover to expand\nClick to play/pause",
    "on-click": "playerctl play-pause",
  },

  // ==========================================
  // MPRIS MEDIA PLAYER
  // ==========================================

  "mpris": {
    "player": "firefox",
    "format": "󰐊 {title}",
    "format-paused": "󰏤 {title}",
    "max-length": 20,
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "{player}: {title} - {artist}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
  },

  // ==========================================
  // CAVA AUDIO VISUALIZER
  // ==========================================

  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava-waybar.py",
    "return-type": "json",
    "format": "{text}",
    "tooltip": true,
  },

  // ==========================================
  // QUICK SETTINGS DRAWER
  // ==========================================

  "group/system-center": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "drawer-child",
      "transition-left-to-right": false,
    },
    "modules": ["custom/system-center", "pulseaudio", "network", "bluetooth"],
  },

  // ==========================================
  // QUICK SETTINGS TRIGGER
  // ==========================================

  "custom/system-center": {
    "format": "󰒓",
    "tooltip": true,
    "tooltip-format": "Nebula Quick Settings\nHover to expand",
    "on-click": "swaync-client -t",
  },

  // ==========================================
  // SYSTEM SEPARATOR
  // ==========================================

  "custom/system-separator": {
    "format": "│",
    "tooltip": false,
  },

  // ==========================================
  // NOTIFICATIONS
  // ==========================================

  "custom/notification": {
    "tooltip": true,
    "tooltip-format": "Notifications\nLeft click: Open center\nRight click: Toggle DND",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },

  // ==========================================
  // AUDIO OUTPUT
  // ==========================================

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "tooltip": true,
    "on-click": "pavucontrol",
    "scroll-step": 5,
  },

  // ==========================================
  // NETWORK
  // ==========================================

  "network": {
    "interval": 5,
    "format-wifi": "󰖩  {signalStrength}%",
    "format-ethernet": "󰈀  Connected",
    "format-disconnected": "󰖪  Offline",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor",
  },

  // ==========================================
  // BLUETOOTH
  // ==========================================

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format": "{status}",
    "on-click": "blueman-manager",
  },

  // ==========================================
  // MICROPHONE MUTE STATUS
  // ==========================================

  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic-status.py",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "format": "{}",
  },

  // ==========================================
  // MICROPHONE PRIVACY
  // ==========================================

  "privacy": {
    "icon-size": 18,
    "icon-spacing": 6,
    "transition-duration": 200,
    "modules": [
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 20,
      },
    ],
    "ignore": [
      {
        "type": "audio-in",
        "name": "cava",
      },
    ],
  },

  // ==========================================
  // SYSTEM TRAY
  // ==========================================

  "tray": {
    "icon-size": 17,
    "spacing": 10,
  },

  // ==========================================
  // GAME MODE
  // ==========================================

  "gamemode": {
    "format": "󰊴",
    "format-alt": "󰊴 {count}",
    "hide-not-running": true,
    "use-icon": false,
    "tooltip": true,
    "tooltip-format": "GameMode active · {count} game(s)",
  },

  // ==========================================
  // POWER MENU
  // ==========================================

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Nebula Power Menu",
    "on-click": "~/.config/rofi/scripts/powermenu.sh",
  },
}
